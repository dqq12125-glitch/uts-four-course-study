APP_ENV=development
APP_BASE_URL=http://localhost:3000
MOBILE_APP_SCHEME=deepstudy
# Set to the canonical HTTPS origin after Universal/App Links are configured.
MOBILE_APP_LINK_BASE_URL=
APPLE_TEAM_ID=
ANDROID_APP_LINK_SHA256_CERT_FINGERPRINTS=

# Email magic-link authentication. Production email delivery is disabled
# until a real provider key and verified sender are configured.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=DeepStudy <no-reply@example.com>
# At least 32 random bytes; signs expiring one-click email unsubscribe links.
UNSUBSCRIBE_TOKEN_SECRET=
IP_HASH_SECRET=

# Phase 1 connector-token envelope encryption. Provide a JSON keyring whose
# values are base64-encoded 32-byte keys; keep retired keys during rotation.
CONNECTOR_TOKEN_ACTIVE_KEY_ID=
CONNECTOR_TOKEN_KEYS=

# Optional Cloudflare Turnstile anti-abuse check for web authentication.
# Keep TURNSTILE_REQUIRED=false until both keys and mobile challenge UX exist.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRED=false

# Private legacy four-course workspace. Leave blank to disable /personal.
# This value is read only on the server and must match the signed-in email.
PERSONAL_OWNER_EMAIL=

# Existing AI tutor. Never expose this key to browser code.
DEEPSEEK_API_KEY=
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_TUTOR_MODEL=
AI_EXTRACTION_MODEL=
AI_LOW_COST_MODEL=
AI_MEDIUM_MODEL=
AI_HIGH_CAPABILITY_MODEL=
AI_EMBEDDING_MODEL=
# Increment when the model or embedding normalization changes.
AI_EMBEDDING_VERSION=
AI_MOCK_ENABLED=false
AI_INPUT_COST_PER_MILLION_MINOR_USD=0
AI_OUTPUT_COST_PER_MILLION_MINOR_USD=0
UPLOADS_MOCK_ENABLED=false
# Local/manual QA only. Ignored in production even if set.
DEVELOPMENT_FULL_ACCESS=false

# Stripe Checkout. Keep PAYMENTS_MOCK_ENABLED false outside automated tests.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_FOUNDING_PASS_PRICE_ID=
STRIPE_SEMESTER_PASS_PRICE_ID=
STRIPE_EXAM_SPRINT_PRICE_ID=
PUBLIC_STRIPE_PUBLISHABLE_KEY=
PAYMENTS_MOCK_ENABLED=false
FOUNDING_PASS_ACCESS_END_AT=2026-12-01T00:00:00+11:00
