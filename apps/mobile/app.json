{
  "expo": {
    "name": "DeepStudy",
    "slug": "deepstudy",
    "scheme": "deepstudy",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.deepstudy.student",
      "config": {
        "usesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:uts-deep-study.dqq12125-study.workers.dev"
      ]
    },
    "android": {
      "package": "com.deepstudy.student",
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2D7A57"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "uts-deep-study.dqq12125-study.workers.dev",
              "pathPrefix": "/auth/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow DeepStudy to securely access your signed-in session."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow DeepStudy to select timetable or course screenshots that you choose.",
          "cameraPermission": "Allow DeepStudy to photograph a timetable or course document when you choose.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F4F1E9",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#111813"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
